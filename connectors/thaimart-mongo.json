{
  "connector.class": "io.debezium.connector.mongodb.MongoDbConnector",
  "tasks.max": "1",
  "mongodb.connection.string": "${file:/secrets/mongo.properties:uri}",
  "topic.prefix": "cdc",

  "database.include.list": "product-api,shop-api,order-api,return-api,review-api",
  "collection.include.list": "product-api\\.(products|productVariants|categories),shop-api\\.shops,order-api\\.orders,return-api\\.returnOrders,review-api\\.reviewSummaries",

  "capture.mode": "change_streams_update_full",
  "snapshot.mode": "initial",
  "snapshot.max.threads": "2",
  "heartbeat.interval.ms": "10000",
  "tombstones.on.delete": "true",

  "topic.creation.default.replication.factor": "3",
  "topic.creation.default.partitions": "1",
  "topic.creation.default.cleanup.policy": "compact",
  "topic.creation.default.max.message.bytes": "8388608",
  "topic.creation.groups": "single",
  "topic.creation.single.include": "cdc\\.order-api\\.orders",
  "topic.creation.single.partitions": "1",
  "topic.creation.single.replication.factor": "3",
  "topic.creation.single.cleanup.policy": "compact",
  "topic.creation.single.max.message.bytes": "8388608",

  "transforms": "unwrap,unwrapMixed,products,variants,categories,shops,orders,returns,reviews",
  "transforms.unwrap.type": "io.debezium.connector.mongodb.transforms.ExtractNewDocumentState",
  "transforms.unwrap.add.fields": "op,source.ts_ms",
  "transforms.unwrap.delete.tombstone.handling.mode": "tombstone",
  "transforms.unwrap.predicate": "hasMixedArrays",
  "transforms.unwrap.negate": "true",
  "transforms.unwrapMixed.type": "io.debezium.connector.mongodb.transforms.ExtractNewDocumentState",
  "transforms.unwrapMixed.add.fields": "op,source.ts_ms",
  "transforms.unwrapMixed.delete.tombstone.handling.mode": "tombstone",
  "transforms.unwrapMixed.array.encoding": "document",
  "transforms.unwrapMixed.predicate": "hasMixedArrays",

  "transforms.products.type": "org.apache.kafka.connect.transforms.ReplaceField$Value",
  "transforms.products.include": "_id,name,images,shopId,categoryPath,status,isAuthenticityGuaranteed,__op,__source_ts_ms",
  "transforms.products.predicate": "isProducts",
  "transforms.variants.type": "org.apache.kafka.connect.transforms.ReplaceField$Value",
  "transforms.variants.include": "_id,productId,status,price,stockedQuantity,reservedQuantity,soldQuantity,__op,__source_ts_ms",
  "transforms.variants.predicate": "isVariants",
  "transforms.categories.type": "org.apache.kafka.connect.transforms.ReplaceField$Value",
  "transforms.categories.include": "_id,parentId,name,__op,__source_ts_ms",
  "transforms.categories.predicate": "isCategories",
  "transforms.shops.type": "org.apache.kafka.connect.transforms.ReplaceField$Value",
  "transforms.shops.include": "_id,status,isOfficialStore,isVerified,common,__op,__source_ts_ms",
  "transforms.shops.predicate": "isShops",
  "transforms.orders.type": "org.apache.kafka.connect.transforms.ReplaceField$Value",
  "transforms.orders.include": "_id,userId,paidAt,status,payment,items,__op,__source_ts_ms",
  "transforms.orders.predicate": "isOrders",
  "transforms.returns.type": "org.apache.kafka.connect.transforms.ReplaceField$Value",
  "transforms.returns.include": "_id,orderId,status,items,__op,__source_ts_ms",
  "transforms.returns.predicate": "isReturns",
  "transforms.reviews.type": "org.apache.kafka.connect.transforms.ReplaceField$Value",
  "transforms.reviews.include": "_id,publishedCount,ratingSum,__op,__source_ts_ms",
  "transforms.reviews.predicate": "isReviews",

  "predicates": "hasMixedArrays,isProducts,isVariants,isCategories,isShops,isOrders,isReturns,isReviews",
  "predicates.hasMixedArrays.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
  "predicates.hasMixedArrays.pattern": "cdc\\.order-api\\.orders|cdc\\.return-api\\.returnOrders",
  "predicates.isProducts.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
  "predicates.isProducts.pattern": "cdc\\.product-api\\.products",
  "predicates.isVariants.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
  "predicates.isVariants.pattern": "cdc\\.product-api\\.productVariants",
  "predicates.isCategories.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
  "predicates.isCategories.pattern": "cdc\\.product-api\\.categories",
  "predicates.isShops.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
  "predicates.isShops.pattern": "cdc\\.shop-api\\.shops",
  "predicates.isOrders.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
  "predicates.isOrders.pattern": "cdc\\.order-api\\.orders",
  "predicates.isReturns.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
  "predicates.isReturns.pattern": "cdc\\.return-api\\.returnOrders",
  "predicates.isReviews.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
  "predicates.isReviews.pattern": "cdc\\.review-api\\.reviewSummaries",

  "errors.log.enable": "true",
  "errors.log.include.messages": "false"
}
